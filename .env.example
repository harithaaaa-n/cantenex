# CANTENEX Environment Configuration Template

# Database Connection (PostgreSQL for Production, Leave blank for local SQLite fallback)
DATABASE_URL=postgresql://cantenex_user:password@localhost:5432/cantenex

# Admin / Kitchen Staff Passcode for Administrative Operations
ADMIN_SECRET=admin123

# Allowed CORS Origins (comma-separated domains or * for development)
# In production: https://cantenex.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Server Port (Default: 8000)
PORT=8000

# Environment Mode (development | production)
ENVIRONMENT=development
